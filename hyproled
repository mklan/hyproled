#!/bin/bash
set -euo pipefail

shift_pixels=false
invert=false
monitor=0
fill_color='0.0,0.0,0.0,1.0'

STATE_FILE="/dev/shm/hyproled_shift.state"
SHADER_FILE="/dev/shm/hyproled_shader.glsl"

export XDG_RUNTIME_DIR="/run/user/$(id -u)"

# Recover broken/stale Hyprland session env automatically
if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || \
   [[ ! -S "$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket.sock" ]]; then
    export HYPRLAND_INSTANCE_SIGNATURE="$(ls "$XDG_RUNTIME_DIR/hypr" | head -n1)"
fi

show_help() {
cat <<EOF
Usage: $(basename "$0") [OPTION]... [off]

Hyprland shader utility to prevent OLED burn in.

version: 0.2.0

Options:
  -a x:y:w:h  Effective area. Useful for bars.
  -i          Invert selected area.
  -s          Shift lit pixels between runs.
  -m ID       Monitor ID from hyprctl monitors.
  -h          Show this help.

Argument:
  off         Disable shader
EOF
}

apply_shader() {
    local shader_path="$1"

    hyprctl eval \
        "hl.config({ decoration = { screen_shader = [[${shader_path}]] } })"
}

disable_shader() {
    hyprctl eval \
        'hl.config({ decoration = { screen_shader = "" } })'
}

if [[ "${1:-}" == "off" ]]; then
    disable_shader
    exit 0
fi

while getopts ":a:ism:h" opt; do
    case "$opt" in
        a) area="$OPTARG" ;;
        i) invert=true ;;
        s) shift_pixels=true ;;
        m) monitor="$OPTARG" ;;
        h)
            show_help
            exit 0
            ;;
        *)
            show_help
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))

# Alternate checkerboard offset
if $shift_pixels; then
    last_shift=0

    [[ -f "$STATE_FILE" ]] && read -r last_shift < "$STATE_FILE"

    if (( last_shift == 0 )); then
        shift_offset=1
        echo 1 > "$STATE_FILE"
    else
        shift_offset=0
        echo 0 > "$STATE_FILE"
    fi
else
    shift_offset=0
fi

shader_code="#version 300 es
precision highp float;

in vec2 v_texcoord;

uniform sampler2D tex;
uniform int wl_output;

layout(location = 0) out vec4 fragColor;

void main() {
    vec4 orig = texture(tex, v_texcoord);

    if (wl_output != ${monitor}) {
        fragColor = orig;
        return;
    }

    vec2 fc = gl_FragCoord.xy;

    bool even =
        mod(fc.x + fc.y + float(${shift_offset}), 2.0) == 0.0;

    vec4 pixel =
        even ? orig : vec4(${fill_color});
"

if [[ -n "${area:-}" ]]; then
    if [[ "$area" =~ ^([0-9]+):([0-9]+):([0-9]+):([0-9]+)$ ]]; then

        x="${BASH_REMATCH[1]}"
        y="${BASH_REMATCH[2]}"
        w="${BASH_REMATCH[3]}"
        h="${BASH_REMATCH[4]}"

shader_code+="
    bool inRegion =
        (fc.x >= ${x}.0 &&
         fc.x <= (${x}.0 + ${w}.0) &&
         fc.y >= ${y}.0 &&
         fc.y <= (${y}.0 + ${h}.0));
"

        if $invert; then
shader_code+="
    fragColor = inRegion ? orig : pixel;
"
        else
shader_code+="
    fragColor = inRegion ? pixel : orig;
"
        fi

shader_code+="
}
"

    else
        echo "Invalid area format. Use x:y:w:h" >&2
        exit 1
    fi
else
shader_code+="
    fragColor = pixel;
}
"
fi

printf '%s\n' "$shader_code" > "$SHADER_FILE"

apply_shader "$SHADER_FILE"
