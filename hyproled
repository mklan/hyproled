#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

read_application_version() {
  local script_path script_dir version_file version

  script_path="${BASH_SOURCE[0]}"

  if [[ "$script_path" == */* ]]; then
    script_dir="${script_path%/*}"
  else
    script_dir="."
  fi

  script_dir=$(cd -- "$script_dir" && pwd -P) || return 1

  version_file="$script_dir/version.txt"
  if [[ ! -r "$version_file" ]]; then
    version_file="$script_dir/../share/hyproled/version.txt"
  fi

  if [[ ! -r "$version_file" ]]; then
    printf 'hyproled: cannot locate version.txt\n' >&2
    return 1
  fi

  if ! IFS= read -r version < "$version_file"; then
    if [[ -z "$version" ]]; then
      printf 'hyproled: cannot read version.txt\n' >&2
      return 1
    fi
  fi

  if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf 'hyproled: invalid version in %s\n' "$version_file" >&2
    return 1
  fi

  printf '%s\n' "$version"
}

